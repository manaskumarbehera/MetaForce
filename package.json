{
  "name": "metaforce-extension",
  "version": "1.0.0",
  "private": true,
  "description": "MetaForce — a Manifest V3 browser extension that fetches and views Salesforce object metadata in-page.",
  "main": "background.js",
  "type": "commonjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\" --ignore-path .prettierignore",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "harness": "node scripts/make-harness.mjs",
    "check:versions": "node scripts/check-version-consistency.cjs",
    "validate": "npm run check:versions && npm run lint && npm test",
    "release": "node scripts/release-all.mjs",
    "chrome:auth": "node scripts/chrome-oauth-token.mjs --write",
    "release:chrome:dry": "node scripts/release-chrome.mjs --dry-run",
    "release:chrome:publish": "node scripts/release-chrome.mjs --publish",
    "release:edge:dry": "node scripts/release-edge.mjs --dry-run",
    "release:edge:publish": "node scripts/release-edge.mjs --publish",
    "build": "./build.sh",
    "build:staging": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "package:chrome": "./build.sh chrome",
    "package:edge": "./build.sh edge",
    "prepare": "husky"
  },
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "manifest-v3",
    "salesforce",
    "metadata"
  ],
  "author": "Manas Kumar Behera <behera.manas98@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.2",
    "archiver": "^7.0.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  }
}
