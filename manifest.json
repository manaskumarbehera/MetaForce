{
  "manifest_version": 3,
  "name": "MetaForce",
  "version": "0.9",
  "description": "A browser extension to fetch and view Salesforce object metadata directly from your browser.",
  "permissions": ["cookies", "clipboardWrite", "offscreen"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.visual.force.com/*",
    "https://*.lightning.force.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.visual.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
